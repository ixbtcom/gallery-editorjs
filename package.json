{
  "name": "@ixbtcom/gallery-editorjs",
  "version": "2.0.1",
  "packageManager": "pnpm@11.1.2",
  "keywords": [
    "codex editor",
    "gallery",
    "carousel",
    "editor.js",
    "editorjs"
  ],
  "description": "Gallery Tool for Editor.js with source attribution and URL upload",
  "license": "MIT",
  "repository": "https://github.com/ixbtcom/gallery-editorjs",
  "files": [
    "dist"
  ],
  "main": "./dist/gallery.umd.js",
  "module": "./dist/gallery.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/gallery.mjs",
      "require": "./dist/gallery.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "devDependencies": {
    "@codexteam/ajax": "^4.2.0",
    "@editorjs/editorjs": "^2.30.8",
    "eslint": "^9.39.5",
    "eslint-config-codex": "^2.0.3",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.41",
    "postcss-nested": "^6.0.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-css-injected-by-js": "^3.5.1",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@codexteam/icons": "^0.3.0",
    "cropperjs": "^1.6.2"
  }
}
